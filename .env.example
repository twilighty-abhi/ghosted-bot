# ── Discord ──────────────────────────────────────────────────────
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id
GUILD_ID=your-server-id

# ── Category IDs (right-click category in Discord → Copy ID) ─────
# Parent category that holds all active cohorts (optional)
ACTIVE_CATEGORY_ID=

# ── Auth & Security (Required for Dashboard) ─────────────────────
DASHBOARD_PASSWORD=changeme_to_admin_password
SESSION_SECRET=a_very_long_random_string_here

# ── Optional Enhancements ────────────────────────────────────────
BOT_LOG_CHANNEL_ID=optional_channel_id_for_bot_webhooks

# ── GUI port (default 3000) ──────────────────────────────────────
GUI_PORT=3000
