{
  "name": "ghosted-bot",
  "version": "1.0.0",
  "description": "Discord bot for GHOSTED cohort management",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "gui": "node src/server.js",
    "gui:dev": "node --watch src/server.js",
    "deploy": "node src/deploy.js",
    "pm2:start": "pm2 start ecosystem.config.js",
